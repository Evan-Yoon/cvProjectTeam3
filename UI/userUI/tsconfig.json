{
  // tsconfig.json은 TypeScript 컴파일러와 에디터가 "이 프로젝트 코드를 어떻게 해석할지" 정하는 파일입니다.
  // 일반 JSON은 주석을 허용하지 않지만, tsconfig는 TypeScript가 JSONC로 읽기 때문에 주석을 사용할 수 있습니다.
  "compilerOptions": {
    // 최신 브라우저/WebView 문법 수준을 목표로 합니다.
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // Vite가 ES 모듈 import/export를 그대로 분석할 수 있게 합니다.
    "module": "ESNext",
    // DOM 타입을 포함해야 window, document, DeviceOrientationEvent 같은 브라우저 API 타입을 쓸 수 있습니다.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // node_modules 타입 오류는 앱 코드 학습/빌드 흐름에서 노이즈가 크므로 검사하지 않습니다.
    "skipLibCheck": true,
    "types": [
      // NodeJS.Timeout 같은 타입과 import.meta.env 같은 Vite 타입을 사용할 수 있게 합니다.
      "node",
      "vite/client"
    ],
    // Vite/현대 번들러 방식의 모듈 해석 규칙을 사용합니다.
    "moduleResolution": "bundler",
    // 각 파일이 독립적으로 변환 가능해야 한다는 제약입니다. Vite/Babel 기반 빌드와 잘 맞습니다.
    "isolatedModules": true,
    "moduleDetection": "force",
    // 일부 JS 파일 import를 허용합니다. wasm 런타임/외부 라이브러리와 섞일 때 유연성이 생깁니다.
    "allowJs": true,
    // JSX를 React 17+ 자동 런타임 방식으로 변환합니다. 그래서 모든 JSX 줄마다 React를 직접 참조하지 않아도 됩니다.
    "jsx": "react-jsx",
    "paths": {
      // vite.config.ts의 alias와 짝을 이루는 설정입니다. "@/..." import를 프로젝트 루트 기준으로 해석합니다.
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    // 타입 검사만 하고 JS 파일을 따로 출력하지 않습니다. 실제 번들은 Vite가 만듭니다.
    "noEmit": true
  }
}
