# .env.example은 필요한 환경변수 이름을 알려주는 샘플입니다.
# 실제 Supabase 키와 백엔드 주소는 .env에 넣고, VITE_ 접두사가 붙은 값만 브라우저 코드에서 읽을 수 있습니다.

# Supabase connection config
# App.tsx가 reports 테이블 조회와 Realtime 구독을 위해 사용합니다.
VITE_SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_ID].supabase.co/
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY_HERE]

# Target API URL for Backend requests
# adminApi.ts가 상태 변경/삭제 요청을 보낼 FastAPI 서버 주소입니다.
VITE_BACKEND_URL=http://localhost:8000
