# .env.example은 필요한 환경변수 이름과 예시를 보여주는 파일입니다.
# 실제 비밀값은 .env에 넣고 Git에는 올리지 않는 것이 원칙입니다.

# Connection string for the PostgreSQL database
# SQLAlchemy가 그대로 사용하는 PostgreSQL 접속 문자열입니다. Supabase를 쓰면 pooler/직접 연결 문자열을 넣습니다.
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]

# AWS S3 Storage Config (for uploading report images)
# reports.py가 받은 이미지를 s3_uploader.py에서 업로드할 때 사용합니다.
AWS_ACCESS_KEY_ID=[YOUR_AWS_ACCESS_KEY_ID_HERE]
AWS_SECRET_ACCESS_KEY=[YOUR_AWS_SECRET_ACCESS_KEY_HERE]
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=[YOUR_S3_BUCKET_NAME_HERE]
# 관리자 UI에서 이미지 썸네일을 보려면 이 URL로 객체를 읽을 수 있어야 합니다.
S3_PUBLIC_BASE_URL=https://[YOUR_S3_BUCKET_NAME_HERE].s3.ap-northeast-2.amazonaws.com

# TMAP API Key for route requesting
# navigation.py가 서버에서 TMAP 보행자 경로 API를 호출할 때 사용합니다.
TMAP_API_KEY=[YOUR_TMAP_API_KEY_HERE]

# Allowed CORS origins
# 브라우저 프론트엔드가 백엔드를 호출할 수 있는 origin 목록입니다. 쉼표로 여러 개를 구분합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
